# ============================================================================
# IRS Mileage Calculator - Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in the values.

# Client-side Google Maps API key (restricted by HTTP referrer).
# Used for: Places Autocomplete (new API), map + route preview (Routes API).
# Enable "Maps JavaScript API", "Places API (New)", and "Routes API"
# for this key. Restrict to your domain (HTTP referrers) in Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: Map ID for route preview waypoint markers (Advanced Markers).
# If set, origin/destination markers appear on the map. Create in Cloud Console
# (Map Management). Leave unset to show only the route polyline.
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Server-side Google Maps API key (Directions API only).
# Used for distance calculations. NEVER exposed to the client.
# On Vercel free tier you cannot IP-restrict (no static egress IPs). In Cloud Console
# set Application restriction to "None" and API restriction to "Restrict key" with
# only "Directions API" allowed. That limits blast radius if the key ever leaks.
GOOGLE_MAPS_API_KEY=

# ---------- Rate Limiting ----------
# Max calculate requests per IP per minute (default: 20)
RATE_LIMIT_MAX_PER_MINUTE=20

# Max calculate requests per IP per hour (default: 100)
RATE_LIMIT_MAX_PER_HOUR=100

# Global daily cap on paid routing API calls (default: 1000)
# When hit, new (uncached) requests return 503 until midnight UTC.
DAILY_API_CAP=1000

# ---------- Caching ----------
# Cache TTL in seconds for route results (default: 604800 = 7 days)
CACHE_TTL_SECONDS=604800

# ---------- Site URL (for sitemap / canonical) ----------
NEXT_PUBLIC_SITE_URL=https://irsmileagecalculator.com
